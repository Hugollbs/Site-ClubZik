# Utilisation : cp .env.example .env, puis adapter les valeurs.
# Tout est local à ta machine : chacun peut choisir ses propres valeurs.

# Base de données locale (lue par docker-compose.yml)
POSTGRES_USER=clubzik
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clubzik

# Drizzle : doit utiliser les mêmes identifiants que ci-dessus
# (format : postgres://USER:PASSWORD@localhost:5432/DB)
DATABASE_URL="postgres://clubzik:change-me@localhost:5432/clubzik"

# Adresse du site en dev (le port par défaut de `npm run dev`)
ORIGIN="http://localhost:5173"

# Better Auth : secret qui signe les sessions
# À générer toi-même avec : openssl rand -base64 32
# Ne jamais commiter la vraie valeur (ce fichier-ci est versionné, .env non)
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
